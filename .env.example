# ============================================================
# ibm_bob_geo_explorer — Variáveis de Ambiente
# ============================================================
# Copie este arquivo para .env e preencha os valores:
#   cp .env.example .env
#
# O arquivo .env NÃO deve ser commitado no repositório.
# O transporte stdio (Bob local) não requer variáveis de ambiente.
# ============================================================

# ------------------------------------------------------------
# Servidor HTTP (ibm_bob_geo_explorer/mcp/src/http.ts)
# Usado apenas ao rodar: node ibm_bob_geo_explorer/mcp/build/http.js
# ------------------------------------------------------------

# Porta TCP onde o servidor HTTP escuta (padrão: 3000)
PORT=3000

# Chave Bearer exigida em todos os requests ao endpoint /mcp.
# Deixe em branco para desabilitar a autenticação (não recomendado em produção).
API_KEY=

# Header Access-Control-Allow-Origin (padrão: * — todas as origens)
# Em produção, restrinja ao domínio do seu frontend/API Gateway.
ALLOWED_ORIGIN=*
